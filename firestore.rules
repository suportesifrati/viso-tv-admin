rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMainAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ti@sifracontabilidade.com';
    }

    function profileExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function panelUser() {
      return isMainAdmin()
        || (profileExists() && profile().active == true);
    }

    function editor() {
      return isMainAdmin()
        || (panelUser() && profile().role == 'editor');
    }

    // TV: autenticada anonimamente, leitura apenas.
    function authenticatedDevice() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isMainAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isMainAdmin();
    }

    match /media/{doc} {
      allow read: if authenticatedDevice();
      allow create, update, delete: if editor();
    }

    match /playlists/{doc} {
      allow read: if authenticatedDevice();
      allow create, update, delete: if editor();
    }

    match /urgent/{doc} {
      allow read: if authenticatedDevice();
      allow create, update, delete: if editor();
    }

    match /settings/{doc} {
      allow read: if authenticatedDevice();
      allow write: if editor();
    }

    match /screens/{doc} {
      allow read: if authenticatedDevice();
      allow write: if editor();
    }

    match /playbackLogs/{doc} {
      allow create: if authenticatedDevice();
      allow read: if panelUser();
      allow update, delete: if isMainAdmin();
    }
  }
}
